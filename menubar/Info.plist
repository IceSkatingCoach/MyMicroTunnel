<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>MyMicroTunnel</string>
  <key>CFBundleDisplayName</key>
  <string>MyMicroTunnel</string>
  <key>CFBundleIdentifier</key>
  <string>ca.maragato.mymicrotunnel-menubar</string>
  <key>CFBundleExecutable</key>
  <string>MyMicroTunnel</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <!-- Sparkle compares CFBundleVersion to decide what is newer, so it has to
       increase monotonically. The git commit does not, which is why it lives in
       its own key below rather than here. -->
  <key>CFBundleVersion</key>
  <string>__VERSION__</string>
  <key>MyMicroTunnelBuildCommit</key>
  <string>__BUILD__</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <!-- Status bar only: no Dock tile, no app switcher entry. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
